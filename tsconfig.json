{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // The TypeScript-side half of `vite.resolve.preserveSymlinks` and the
    // `NODE_OPTIONS=--preserve-symlinks` the npm scripts carry. In local-CMS
    // mode (`npm run dev:cms`) `node_modules/@codeyam/cms` is a symlink to the
    // codeyam-cms checkout, and TS resolves through symlinks to the real path
    // unless told otherwise — so `@codeyam/cms/content`'s `astro/loaders` and
    // `astro/zod` came from the *checkout's* Astro rather than this project's.
    // Those are different majors on purpose (the CMS supports Astro 5, 6 and 7
    // and develops against 7; this site is on 6), and a zod-major mismatch made
    // every collection schema in `src/content.config.ts` a type error. Keeping the
    // resolution on the `node_modules` path gives the whole program one Astro.
    // Unconditional like the Node flag: with no linked package there are no
    // symlinks to preserve, so it costs nothing and both states just work.
    "preserveSymlinks": true
  }
}
