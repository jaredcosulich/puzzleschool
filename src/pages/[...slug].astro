---
// The internal-page template — and the route that makes CMS-authored pages real.
//
// Without this route, creating a page in /admin produces a markdown entry that
// nothing ever puts at a URL: the entry exists, the dashboard lists it, and the
// site 404s. (That is the state the @codeyam/cms demo site ships in — its own
// nav.json links to /pages/about while its only routes are index, 404 and
// blog/[slug].) One dynamic route closes the loop: create a page in /admin, it
// commits markdown here, the build emits a page for it, and it is live, with no
// code change. That is the entire promise of running on the CMS.
//
// Because every page shares this template, a page created next year gets the
// same morse rule, the same structure lane, and the same band as the About page
// written today. The handoff calls About "the template for any internal pages";
// this is that, enforced.
//
// Two filters, and they are NOT interchangeable:
//   - `routableEntries` decides which pages get BUILT: published entries PLUS
//     previews, because a shared preview link must resolve even though the page
//     is unpublished.
//   - `publishedEntries` is the listing rule, for anywhere pages are enumerated.
// Filtering the listing but not `getStaticPaths` is the classic failure: the
// draft vanishes from navigation but stays publicly reachable at its own URL —
// hidden, not private, which reads as working draft support and is worse than
// none.
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { routableEntries } from '@codeyam/cms/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MorseRule from '../components/structures/MorseRule.astro';
import SineRule from '../components/structures/SineRule.astro';
import PageHeader from '../components/page/PageHeader.astro';
import ProseColumns from '../components/page/ProseColumns.astro';
import ContactButton from '../components/page/ContactButton.astro';
import ExploratoryBand from '../components/page/ExploratoryBand.astro';
import { getSettings } from '../lib/site';
import { buildMailto } from '../lib/mailto';
import { proseLayoutFor } from '../lib/proseLayout';

export const getStaticPaths = (async () => {
  const pages = routableEntries(await getCollection('pages'));
  return pages
    // `home` is served at `/` by index.astro. Skipping it here keeps one entry
    // from being reachable at both `/` and `/home`.
    .filter((page) => page.id !== 'home')
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content, headings } = await render(page);
const {
  title,
  description,
  kicker,
  intro,
  heading,
  bandBody,
  quote,
  quoteAttribution,
  showContactButton,
} = page.data;

// Which prose shape this page gets — two columns with the branching structure in
// the gap, or a centred single column flanked by two others — derived from the
// body's own section count rather than declared in frontmatter. The rule and the
// reasoning behind deriving it live in `proseLayoutFor`, where they are
// unit-testable; `render()` hands back `headings` for free, so the route asks.
const proseLayout = proseLayoutFor(headings);

const settings = getSettings();
const contactHref = buildMailto({
  to: settings.contactEmail,
  subject: `Hello from ${settings.siteTitle}`,
});
---

<BaseLayout title={title} description={description} entryKey={`pages/${page.id}`}>
  <MorseRule />
  <PageHeader title={title} kicker={kicker} intro={intro} />
  <SineRule />
  <!-- The page's own id seeds its structure, so every CMS-authored page gets a
       tree of its own with no code change — the same way it gets the morse rule
       and the band. -->
  <!-- The CTA goes in the `foot` slot rather than after `<ProseColumns>`: the
       tree hangs from the bottom of the prose block, so a sibling here would
       push the band down and leave the trunk ending in mid-air. `<Content />`
       must stay in the DEFAULT slot — it is the CMS body target, and moving it
       would break staged preview patching. -->
  <ProseColumns seedKey={page.id} layout={proseLayout}>
    <Content />
    {showContactButton ? <ContactButton href={contactHref} slot="foot" /> : null}
  </ProseColumns>
  {
    heading ? (
      <ExploratoryBand
        heading={heading}
        bandBody={bandBody}
        quote={quote}
        quoteAttribution={quoteAttribution}
        seedKey={page.id}
      />
    ) : null
  }
</BaseLayout>
