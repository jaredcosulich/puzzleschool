---
// Isolation page for VoronoiField — codeyam screenshots the #codeyam-capture
// wrapper by navigating to /isolated-components/VoronoiField.
//
// `?tree=static` is in the registered URL so the capture records the build-time
// field with no client redraw and no race against the screenshot. Register with:
//   codeyam-editor editor register '{"name":"VoronoiField - Default","componentName":"VoronoiField","url":"/isolated-components/VoronoiField?tree=static","dimensions":["Desktop"]}'
//
// The lane is shown at its real 123x365 — the component's own default. This is
// also the frame where the two deliberate incompletenesses have to be legible:
// one cell drawn an edge short, and one or two crosses marking sites the
// partition has not accounted for at all.
import Component from "../../components/structures/VoronoiField.astro";
import "../../styles/tokens.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VoronoiField</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--paper);">
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      <div style="width: 123px;">
        <Component seedKey="contact" />
      </div>
    </div>
  </body>
</html>
