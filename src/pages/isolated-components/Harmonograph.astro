---
// Isolation page for Harmonograph — codeyam screenshots the #codeyam-capture
// wrapper by navigating to /isolated-components/Harmonograph.
//
// `?tree=static` is in the registered URL so the capture records the build-time
// figure with no client redraw and no race against the screenshot. Register with:
//   codeyam-editor editor register '{"name":"Harmonograph - Default","componentName":"Harmonograph","url":"/isolated-components/Harmonograph?tree=static","dimensions":["Desktop"]}'
//
// The lane is shown at its real 200x365 (`FLANK_LANE`) — the component's own
// default — because a figure judged at any other size is a figure the site never
// renders. It is also the width the aspect ceiling is derived from, so a capture
// at any other width would not show whether the figure fills its lane's height.
import Component from "../../components/structures/Harmonograph.astro";
import { FLANK_LANE } from "../../lib/structures";
import "../../styles/tokens.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>Isolated: Harmonograph</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--paper);">
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      <div style={`width: ${FLANK_LANE.width}px;`}>
        <Component seedKey="contact" />
      </div>
    </div>
  </body>
</html>
