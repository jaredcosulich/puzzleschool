---
// Isolation page for ProseColumns in its one-section shape — codeyam screenshots
// the #codeyam-capture wrapper by navigating to
// /isolated-components/ProseColumnsSingle.
//
// This stack is a static export, so each STATE gets its own prerendered page:
// `?s=` query params are empty at build time and would capture the default frame
// for every state. That is why this is a separate file from ProseColumns.astro
// rather than a query parameter on it.
//
// Register with:
//   codeyam-editor editor register '{"name":"ProseColumns - Single Section","componentName":"ProseColumns","url":"/isolated-components/ProseColumnsSingle?tree=static","dimensions":["Desktop"]}'
//
// The band is rendered here deliberately, exactly as ProseColumnsWithFoot does
// it. The seam guarantee — both flanking structures sitting ON the join with the
// section below rather than floating above it — is not observable with nothing
// underneath, and this shape has TWO figures that can each break it
// independently. The `foot` slot is filled for the same reason: the CTA has to
// sit inside the prose grid, or the band gets pushed down and both figures end
// in mid-air.
//
// One section, which is what selects this layout at the route. The prose is
// deliberately short, so `min-height` sets the block's height rather than the
// copy — the case where the lanes are easiest to get wrong.
import Component from "../../components/page/ProseColumns.astro";
import ContactButton from "../../components/page/ContactButton.astro";
import ExploratoryBand from "../../components/page/ExploratoryBand.astro";
import "../../styles/tokens.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>Isolated: ProseColumnsSingle</title>
  </head>
  <body style="margin: 0; min-height: 100vh; background: var(--paper);">
    <div id="codeyam-capture" style="width: 100%;">
      <Component seedKey="isolated-single" layout="single">
        <h3>Who we want to hear from</h3>
        <p>Families thinking about what their children will need. Teachers who have taught into ambiguity on purpose.</p>
        <p>We read everything that comes in, and we answer.</p>
        <ContactButton href="mailto:hello@example.com" slot="foot" />
      </Component>
      <ExploratoryBand
        heading="The Puzzle School is currently in an exploratory phase."
        bandBody="We do not yet have any opening date. We read everything that comes in, and we answer."
      />
    </div>
  </body>
</html>
