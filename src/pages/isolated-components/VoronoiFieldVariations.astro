---
// Eight Voronoi fields from eight fixed seeds, side by side.
//
// The envelope sheet, for the same reason the tree and the harmonograph have
// one: a single field either looks fine or it does not, and only a row of them
// shows whether the CONSTRAINTS hold. What this sheet is watching for is
// specific — slivers (the long thin shard between two sites that landed too
// close, which reads as a drawing mistake rather than a boundary), and whether
// the two deliberate incompletenesses actually land in every draw.
//
// The seeds are FIXED and arbitrary, not slugs, because this sheet is about the
// envelope rather than about any particular page. Register with:
//   codeyam-editor editor register '{"name":"VoronoiField - Variations","componentName":"VoronoiField","url":"/isolated-components/VoronoiFieldVariations?tree=static","dimensions":["Desktop"]}'
//
// Each caption carries the two facts that are INVISIBLE in the geometry — how
// many sites were left unresolved, and whether a cell was actually opened. That
// is the `bareLimbApplied` lesson: a deliberate feature that silently failed to
// apply looks exactly like one that was never asked for.
import Component from "../../components/structures/VoronoiField.astro";
import { growAcceptableVoronoi } from "../../lib/voronoi";
import { FLANK_LANE } from "../../lib/structures";
import "../../styles/tokens.css";

const SEEDS = [1, 7, 11, 23, 42, 99, 256, 1024];
const FIELDS = SEEDS.map((seed) => ({ seed, field: growAcceptableVoronoi(seed) }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VoronoiField — Variations</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--paper);">
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      <div class="sheet">
        {
          FIELDS.map(({ seed, field }) => (
            <figure class="specimen">
              <Component seed={seed} />
              <figcaption>
                {seed}
                <span class="facts">
                  {field.cells.length} cells · {field.unresolved.length} unresolved ·{' '}
                  {field.openCellApplied ? 'open cell' : 'NO OPEN CELL'}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </body>
</html>

<style define:vars={{ laneWidth: `${FLANK_LANE.width}px` }}>
  /* Eight lanes at their real width, read from `FLANK_LANE` rather than restated
     — judging the envelope at any other width would judge a field the site never
     renders, and doubly so here: this figure is GENERATED at the lane and drawn
     with `preserveAspectRatio="none"`, so a mismatched box would stretch every
     cell rather than letterbox it. What this sheet watches for is the sliver, and
     now also the stretch: at 3–4 columns against 5–7 rows the cells should read
     as roughly square, not wide. */
  /* WRAPS rather than shrinking. Eight 200px lanes plus their gaps are wider than
     the page, and the one thing this sheet may not do is show the fields at a
     width the site never renders — so the row breaks onto a second line instead
     of squeezing the specimens or clipping the outer ones. */
  .sheet {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 32px 24px;
  }

  .specimen {
    margin: 0;
    width: var(--laneWidth);
  }

  figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--body-text, #666);
  }

  .facts {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.02em;
    opacity: 0.75;
  }
</style>
