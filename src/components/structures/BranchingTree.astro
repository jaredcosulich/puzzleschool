---
// The branching structure standing between the About page's prose columns.
//
// Two things about its placement are load-bearing, and getting either wrong is
// immediately visible:
//
//   1. It is ANCHORED TO THE BOTTOM of its column and flipped `scaleY(-1)`. The
//      generator grows downward from the origin; the flip turns that into a tree
//      rising from the foot of the column. Un-flipped it reads as a root system
//      hanging from the ceiling — which is what "upside down" describes, and is
//      wrong.
//   2. It lives in its OWN 123px grid column, not floated over the prose. The
//      design's prose grid is `1fr 123px 1fr` precisely so this has a lane of its
//      own; dropped into a text column it lands on the words.
//
// TWO SEEDS, TWO MOMENTS. The structure is supposed to read as something grown,
// and one frozen specimen repeated down every page undercuts that. So it varies
// on two axes at once:
//
//   - PER PAGE, at build time: the seed is hashed from `seedKey` (the page
//     slug), so About, Contact and a page a CMS editor writes next year each
//     grow their own tree with no code change — and the SAME tree on every
//     build, which is what keeps the committed screenshots from churning.
//   - PER VISIT, in the browser: the script below regrows each tree from a fresh
//     random seed after load.
//
// The server tree and the client tree genuinely differ; that is the point. Which
// means the SSR tree must be VALID ON ITS OWN, not a placeholder — it is what
// no-JS visitors keep, and what everyone sees for the frames before the script
// runs. `?tree=static` suppresses the regrow entirely, so screenshot captures
// get the deterministic build-time tree with no swap and no race.
//
// One limb is left bare: `bareLimb` names which branch stops without spawning
// children. That is sampled inside the envelope now rather than passed in, and
// `growAcceptableTree` rejects a draw where the named limb was never reached.
import { growAcceptableTree, resolveTreeSeed, treeViewBox, toPath } from '../../lib/structures';

interface Props {
  /**
   * What this tree is grown FROM — normally the page slug. Hashed to a seed, so
   * distinct pages get distinct trees and each page keeps its own across builds.
   */
  seedKey?: string;
  /** An explicit seed, overriding `seedKey`. For the variations sheet. */
  seed?: number;
  /** The lane the figure fills. A layout fact, not a variation axis. */
  width?: number;
  height?: number;
}

const { seedKey, seed, width = 123, height = 365 } = Astro.props;

const { segments } = growAcceptableTree(resolveTreeSeed(seed, seedKey));
const viewBox = treeViewBox(segments);
---

<div class="tree-well">
  <div class="tree-flip">
    <!-- `preserveAspectRatio="none"` fills the 123x365 lane exactly, the way the
         design's own SVG does. With `meet` the figure is letterboxed to whichever
         axis binds first and lands at about a third of the lane's height —
         present, but too faint to read as a structure. -->
    <svg
      data-tree
      viewBox={viewBox}
      width={width}
      height={height}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {
        segments.map((segment) => (
          <path
            d={toPath([segment.from, segment.to])}
            fill="none"
            stroke="var(--gold)"
            stroke-width={segment.width}
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </svg>
  </div>
</div>

<script>
  import { growAcceptableTree, randomTreeSeed } from '../../lib/structures';
  import { applyTreeGrowth } from '../../lib/tree-dom';

  // Presence-only flag, and deliberately not a seed. The site is prerendered, so
  // a query parameter cannot reach the server render at all — it can only tell
  // the browser what to do afterwards. A value-carrying `?tree=<seed>` would
  // make the client draw a DIFFERENT tree than the server did, reintroducing
  // exactly the swap (and the race against the capture) that a screenshot must
  // not contain. Saying "leave the SSR tree alone" removes the race outright.
  const frozen = new URLSearchParams(location.search).get('tree') === 'static';

  if (!frozen) {
    for (const svg of document.querySelectorAll<SVGSVGElement>('svg[data-tree]')) {
      // A failed regrow must leave the server's tree standing rather than an
      // empty lane — the SSR figure is already correct, this is an enhancement.
      try {
        const { segments } = growAcceptableTree(randomTreeSeed());

        // Grow first, write in one frame: reframing the viewBox and rewriting
        // the paths across separate frames would show the old tree stretched
        // into the new box.
        requestAnimationFrame(() => applyTreeGrowth(svg, segments));
      } catch {
        // Intentionally silent: an ambient decorative figure is not worth a
        // console error on a visitor's page.
      }
    }
  }
</script>

<style>
  /* The 123px grid column the structure occupies. */
  .tree-well {
    position: relative;
    min-height: 365px;
  }

  .tree-flip {
    position: absolute;
    bottom: 0;
    left: 0;
    transform: scaleY(-1);
    opacity: 0.8;
    pointer-events: none;
  }

  .tree-flip svg {
    display: block;
    overflow: visible;
  }

  /* Below the prose breakpoint the middle column stops existing, so the well
     collapses rather than leaving a 365px hole. */
  @media (max-width: 840px) {
    .tree-well {
      display: none;
    }
  }
</style>
