---
// The Fibonacci square spiral that grows upward out of the Contact card's teal
// rule. Its bottom edge overlaps that rule by a couple of pixels, so the
// structure looks like it is rooted in the card rather than floating above it.
//
// The largest square is drawn as three sides. At every smaller scale the spiral
// closes; at the largest it does not.
import { fibonacciTiling, openRectPath } from '../../lib/structures';

interface Props {
  /** How many Fibonacci squares, including the open one. */
  count?: number;
  /** Side of the two seed squares. */
  unit?: number;
  /** Rendered width in px; height follows the tiling's aspect ratio. */
  width?: number;
}

const { count = 6, unit = 13, width = 177 } = Astro.props;

const tiling = fibonacciTiling(count, unit);
const height = Math.round((width * tiling.height) / tiling.width);
---

<svg
  class="structure fibonacci"
  viewBox={`-1 -1 ${tiling.width + 2} ${tiling.height + 2}`}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  {
    tiling.rects.map((rect) => (
      <rect
        x={rect.x}
        y={rect.y}
        width={rect.size}
        height={rect.size}
        fill="none"
        stroke="var(--teal)"
        stroke-width="1"
      />
    ))
  }
  {
    tiling.open ? (
      <path d={openRectPath(tiling.open)} fill="none" stroke="var(--teal)" stroke-width="1" />
    ) : null
  }
</svg>

<style>
  .fibonacci {
    /* Positioned by the card grid that hosts it; `top` pulls it up so its bottom
       edge overlaps the Contact card's 6px teal rule. */
    top: -106px;
    left: var(--gutter-wide);
    overflow: visible;
  }

  /* Below the card-grid breakpoint the structure is dropped rather than scaled —
     the handoff is explicit that shrinking these turns hairlines to mud. */
  @media (max-width: 840px) {
    .fibonacci {
      display: none;
    }
  }
</style>
