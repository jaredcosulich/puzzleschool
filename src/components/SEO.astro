---
// Per-page <head> meta: title, description, canonical, Open Graph + Twitter
// card tags. Defaults come from the editable `settings` singleton so every
// page is consistent; pages override per-route via props. Rendered inside the
// base layout's <head>. (Site-level sitemap.xml / robots.txt live in the
// deploy-hardening stack, not here — this component owns the per-page tags.)
import { composePageTitle } from '../lib/pageTitle';
import { getSettings } from '../lib/site';
const settings = getSettings();

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;

// A page title becomes "Page · Site"; a page that passes no title — or one
// whose title already IS the site title, as home's does — gets the bare site
// title instead of it twice over. Feeds <title>, og:title and twitter:title.
const pageTitle = composePageTitle(title, settings.siteTitle);
const metaDescription = description ?? settings.description;
const canonicalUrl = canonical ?? Astro.url.href;
---

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />

{/* The compass mark, on the ink ground so it holds shape at 16px — the paper
    variant dissolves into speckle at tab size. `.svg` is what modern browsers
    take; `.ico` is the fallback they probe for by name when SVG is unsupported,
    and it must stay listed so Safari < 17 and feed readers find it. */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
{image ? <meta property="og:image" content={image} /> : null}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{image ? <meta name="twitter:image" content={image} /> : null}
