---
// Two columns of prose with the branching structure standing in the gap between
// them.
//
// The column gap is the structure's 123px lane plus its two 40px gutters, so the
// text lands exactly where the design's `1fr 123px 1fr` grid puts it while the
// body stays ONE markdown blob the CMS can edit. A real grid track would force
// the body to be split into two separate fields, which would mean a CMS editor
// could no longer just write a page.
//
// `seedKey` is passed straight through to the structure: it is what makes each
// page's tree its own. Forwarded rather than read here because this component
// does not know what page it is on — the route does.
//
// TWO PROSE SHAPES, and which one a page gets is decided by the route from the
// page's own section count — not declared here and not declared in frontmatter.
//
//   - `columns`: two columns with the branching structure standing in the gap.
//     Right for a page with two or more sections, and the default, so every
//     existing caller renders exactly as it did before this prop existed.
//   - `single`: ONE centred column with a different structure standing in a lane
//     to its left and another to its right. Right for a page that only wants to
//     say one thing, where the two-column shape leaves a half-empty second
//     column with the tree stranded beside it.
//
// KNOWN LIMIT, worth writing down rather than leaving to be discovered: staged
// CMS preview patches `.prose`'s innerHTML in place, so editing a body from two
// sections down to one does NOT re-pick the layout until the next build. That is
// acceptable — the layout is a build-time fact, decided where the markdown is
// rendered — but it means the preview of such an edit shows the old shape.
import BranchingTree from '../structures/BranchingTree.astro';
import Harmonograph from '../structures/Harmonograph.astro';
import VoronoiField from '../structures/VoronoiField.astro';
import { cmsBody } from '../../lib/cmsMarkers';

interface Props {
  /** Identifies the page, so its structures are distinct from every other page's. */
  seedKey?: string;
  /**
   * Which prose shape to render. Defaults to the two-column form, so a caller
   * that says nothing keeps the layout it already had.
   */
  layout?: 'columns' | 'single';
}

const { seedKey, layout = 'columns' } = Astro.props;
const single = layout === 'single';
---

<div class:list={['prose-grid', single && 'prose-grid--single']}>
  {/* The body marker goes on `.prose`, not `.prose-grid`: patching sets
      innerHTML, and the grid also holds the structures — marking it would
      delete their SVGs on every staged body edit. */}
  <div class="prose" {...cmsBody()}><slot /></div>
  {/* Anything a page wants between its prose and the section below goes HERE,
      not after `<ProseColumns>` — see the `.tree-well` note below for why. */}
  <div class="prose-foot"><slot name="foot" /></div>
  {
    single ? (
      <>
        <Harmonograph seedKey={seedKey} />
        <VoronoiField seedKey={seedKey} />
      </>
    ) : (
      <BranchingTree seedKey={seedKey} />
    )
  }
</div>

<style>
  .prose-grid {
    position: relative;
    padding: 64px var(--gutter) 0;
    /* The structure lane is 365px tall and hangs from the BOTTOM of this grid,
       so on a page with little prose the tree rises past the grid's top edge and
       crosses the sine rule above it — reading as though it grew through the
       separator rather than standing under it. Reserving the lane's full height
       plus a little clearance keeps the whole figure below the rule no matter
       how little prose sits beside it, without clipping a limb to do it.
       (365px is the lane height BranchingTree draws at; 123px, its width, is
       already hardcoded below for the same reason.)
       This is a floor for the prose block INCLUDING its `foot` slot: a taller
       block only pushes the tree further below the sine rule, never above it,
       so the guard still holds when a page slots a CTA in. */
    min-height: calc(365px + 24px);
  }

  /* Slotted content is bled back out of the grid's own gutter so it keeps the
     exact geometry it would have had as a sibling of `.prose-grid` — a CTA that
     pads by `--gutter` itself lines up with the prose's left edge rather than
     indenting twice. Collapses to zero height when the slot is empty, so a page
     with no foot renders identically to before the slot existed. */
  .prose-foot {
    margin: 0 calc(var(--gutter) * -1);
  }

  .prose {
    columns: 2;
    column-gap: 203px; /* 123px lane + 2 × 40px gutter */
    padding-bottom: 72px;
  }

  /* Each section starts its own column, so a long edit can never split a section
     across the structure lane. */
  .prose :global(h3) {
    margin: 0 0 18px;
    font-weight: 600;
    font-size: 30px;
    letter-spacing: -0.03em;
    color: var(--ink);
    break-after: avoid;
  }

  .prose :global(h3:not(:first-child)) {
    break-before: column;
  }

  .prose :global(p) {
    margin: 0 0 18px;
    font-size: var(--size-body-card);
    line-height: 1.7;
    color: var(--body-text);
  }

  /* The structure stands IN the gap between the columns, centred, sitting on the
     seam with the section below so it reads as growing out of it.
     The foot is measured from THIS element's bottom edge, which is why anything
     a page puts between the prose and the section below has to go in the `foot`
     slot: rendered as a sibling AFTER `<ProseColumns>` it pushes that section
     down while leaving the tree's anchor where it was, and the trunk ends in
     mid-air by exactly the sibling's height. */
  .prose-grid :global(.tree-well) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 123px;
    margin-left: -61.5px;
  }

  /* ------------------------------------------------------------------------
     The one-section shape: prose centred, a structure in a lane either side.
     ------------------------------------------------------------------------ */

  /* A real grid here, where the two-column shape uses CSS columns, and the
     difference is not stylistic. Columns work there because the body must stay
     ONE markdown blob the CMS can edit — a grid would force it into two fields.
     Here the body is a single column anyway, so the grid costs nothing and buys
     the thing hand-positioning could not: the browser computes the lane offsets,
     so the 40px gutters hold exactly at every width instead of being derived
     from a percentage that resolves against a different box than the prose's. */
  .prose-grid--single {
    display: grid;
    grid-template-columns: 123px minmax(0, var(--measure-body)) 123px;
    /* The rows are declared EXPLICITLY, and that is load-bearing rather than
       tidy: `grid-row: 1 / -1` on the lanes below resolves `-1` against the
       EXPLICIT grid, so with rows left implicit `-1` collapses back to line 1
       and each lane is auto-placed into the first row instead of spanning to the
       bottom. The figures then hang from the bottom of the prose row and float
       above the seam by exactly the height of the foot. */
    grid-template-rows: 1fr auto;
    column-gap: 40px; /* the same 40px the two-column gap is built from */
    justify-content: center;
  }

  .prose-grid--single .prose {
    columns: 1;
    grid-column: 2;
    grid-row: 1;
  }

  .prose-grid--single .prose-foot {
    grid-column: 2;
    grid-row: 2;
  }

  /* Both lanes span BOTH rows and stretch, so their bottom edge is the bottom of
     the foot row — which is the whole prose block's bottom, and therefore the
     seam with the section below. Each figure is anchored to the bottom of its
     own well, so this is what puts them ON that seam rather than floating above
     it, exactly as `.tree-well` is bottom-anchored in the two-column shape.
     Positioning lives here rather than in the components so each of those owns
     only its own geometry. */
  .prose-grid--single :global(.harmonograph-well) {
    grid-column: 1;
    grid-row: 1 / -1;
  }

  .prose-grid--single :global(.voronoi-well) {
    grid-column: 3;
    grid-row: 1 / -1;
  }

  @media (max-width: 840px) {
    .prose {
      columns: 1;
    }

    /* Below this breakpoint the lane collapses and the tree is not drawn at all,
       so the height reserved for it would just be a tall empty gap. */
    .prose-grid {
      min-height: 0;
    }

    /* Both flanking lanes are `display: none` at this width, so the three-track
       grid would leave their two 123px columns standing empty. Back to flow. */
    .prose-grid--single {
      display: block;
    }
  }
</style>
