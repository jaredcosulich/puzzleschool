---
// The home page's ink band: night-variant mark, pull quote, attribution — with
// the Koch fragment anchored inside it but hanging far above.
//
// NO overflow clip on this band. The fragment is drawn in ink, so it is
// invisible against the band itself and only becomes legible where it crosses
// onto the paper above. Clipping the band erases it completely: the element
// stays in the DOM with a correct stroke, and nothing renders.
import Mark from '../Mark.astro';
import KochFragment from '../structures/KochFragment.astro';
import { cmsField } from '../../lib/cmsMarkers';

interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<section class="band bleed">
  <div class="band__inner measure">
    <KochFragment />
    <Mark variant="signalNight" size={104} />
    <blockquote {...cmsField('quote')}>{quote}</blockquote>
    {
      attribution ? (
        <p class="attribution" {...cmsField('quoteAttribution')}>
          {attribution}
        </p>
      ) : null
    }
  </div>
</section>

<style>
  /* The ink reaches the viewport edge; everything inside it stays on the same
     1280 measure as the rest of the page. */
  .band {
    position: relative;
    background: var(--ink);
    color: var(--paper);
  }

  /* The positioning origin for the Koch fragment, and the reason this wrapper
     exists. `KochFragment` places itself with a `left` offset that assumes the
     page canvas — once the band bled to 100vw, that offset started counting
     from the SCREEN edge and the figure drifted left by half the difference.
     Matching `.page`'s own geometry (max-width capped, auto-centred, padding
     inside) puts the origin back on the canvas, so the curve's peak lands on
     the centre of the empty third card column at any width. */
  .band__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding: clamp(56px, 8vw, var(--space-4xl)) var(--gutter-wide);
    text-align: center;
  }

  .band blockquote {
    position: relative;
    margin: 0;
    max-width: var(--measure-quote);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, var(--size-quote));
    line-height: 1.14;
    letter-spacing: -0.03em;
  }

  .attribution {
    position: relative;
    margin: 0;
    max-width: 600px;
    font-size: var(--size-body-ink);
    line-height: 1.65;
    color: var(--body-on-ink);
  }
</style>
