---
// The site-wide shell: <head> meta via SEO, the page canvas, and the chrome.
// Header and footer read from `src/data/*.json`, so changing the site title, a
// menu item, the footer line, or where the footer's Contact link points is a
// CMS edit — never a markup change. That last one is indirect: the footer link
// resolves out of the nav singleton, so moving the Contact page in the menu
// moves the footer link too.
//
// The site is full-width: paper runs edge to edge, and the dark bands bleed to
// the viewport via the `.bleed` utility in tokens.css. `.page` survives only as
// a 1280px reading measure that keeps content centred — it paints nothing, so
// there is no canvas edge and no desk behind it.
//
// It used to be a literal page: a 1280px paper canvas with a hairline border on
// a darker desk. That framing read as dated at wide viewports, mostly because
// the ink bands stopped at 1280 too.
//
// `showNav` selects which of the two page shapes this is. Home has no nav bar —
// its masthead IS the navigation — and its footer sits on the wider gutter.
import '../styles/tokens.css';
import SEO from '../components/SEO.astro';
import SiteNav from '../components/chrome/SiteNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { getNav, getSettings } from '../lib/site';
import { resolveContactUrl } from '../lib/contactUrl';
import { cmsEntry } from '../lib/cmsMarkers';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Show the internal-page nav bar. Home passes false. */
  showNav?: boolean;
  /**
   * The `<collection>/<slug>` identity of the entry this page renders, e.g.
   * `pages/about`. Marks `.page` as the staged-preview entry root, so the CMS
   * patches the marked fields below it exactly instead of guessing by shape.
   * Pages that render no single entry (the isolated-component pages) omit it
   * and emit no attribute at all.
   */
  entryKey?: string;
}

const settings = getSettings();
const nav = getNav();
const { title, description, image, showNav = true, entryKey } = Astro.props;

// Resolved from the nav singleton, so an editor who moves or renames the
// Contact page in the CMS retargets the footer link with it. The mailto still
// exists, but it belongs to the Contact page's own button — not to the one
// link on every page that says "Contact" and ought to go to that page.
const contactUrl = resolveContactUrl(nav);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} image={image} />
  </head>
  <body>
    <div class="page" {...cmsEntry(entryKey)}>
      {
        showNav ? (
          <SiteNav
            siteTitle={settings.siteTitle}
            items={nav.items}
            currentPath={Astro.url.pathname}
          />
        ) : null
      }

      <slot />

      <SiteFooter
        text={settings.footerText}
        contactUrl={contactUrl}
        variant={showNav ? 'internal' : 'home'}
      />
    </div>
  </body>
</html>

<style>
  .page {
    /* No background, border or overflow clip: the body is paper, so this is a
       reading measure rather than a visible canvas. The clip in particular had
       to go — it would clip the `.bleed` bands back to this width. Horizontal
       overhang is contained by `overflow-x: clip` on html/body in tokens.css. */
    width: min(var(--page-width), 100%);
    margin: 0 auto;
    color: var(--ink);
  }
</style>
