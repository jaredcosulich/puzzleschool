{
  "name": "puzzleschool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "NODE_OPTIONS=--preserve-symlinks astro dev --host 127.0.0.1",
    "dev:cms": "npm link @codeyam/cms && npm run dev",
    "cms:unlink": "npm unlink @codeyam/cms && npm install @codeyam/cms",
    "build": "NODE_OPTIONS=--preserve-symlinks astro check && NODE_OPTIONS=--preserve-symlinks astro build",
    "preview": "astro preview",
    "check": "NODE_OPTIONS=--preserve-symlinks astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "npm install"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.7.0",
    "@codeyam/cms": "^0.9.0",
    "astro": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "typescript": "^5",
    "vitest": "^3"
  }
}
